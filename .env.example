# ============================================================
# MedRev — Environment Variables
# Copiez ce fichier en .env.local et remplissez vos valeurs
# ============================================================

# Supabase (Settings → API dans votre dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Google Gemini (gratuit — aistudio.google.com/apikey)
# Clé commence par AIza...
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxx

# Stripe (optionnel — pour les paiements Premium)
STRIPE_SECRET_KEY=sk_live_ou_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_ou_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# URL de l'app
NEXT_PUBLIC_APP_URL=http://localhost:3000
